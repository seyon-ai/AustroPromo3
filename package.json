{
  "name": "austroclash-film",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:assets": "python3 scripts/make_logo.py && python3 scripts/make_sfx_music.py",
    "build:timing": "node scripts/build-timing.mjs",
    "preview": "remotion studio",
    "render": "remotion render AustroClashFilm out/AustroClashFilm.mp4 --codec=h264 --crf=18",
    "render:vertical": "remotion render AustroClashFilmVertical out/AustroClashFilmVertical.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "@remotion/transitions": "4.0.290",
    "remotion": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}
